# MENO Hub — copy to .env.local (development) and fill in. NEVER put real values in this file.

# MongoDB connection. MongoDB Atlas (free M0 cluster) for the team:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Leave empty in development to use an in-memory MongoDB (data is lost on restart).
MONGODB_URI=

# Random 32+ character secret used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_SESSION_SECRET=

# Password given to the team accounts on first seed. Everyone must change it after first login.
SEED_DEFAULT_PASSWORD=

# Login email per team member (slug:email, comma-separated). Members not listed get <slug>@meno.team.
HUB_TEAM_EMAILS=nitheesh:,prakalya:,kamesh:,meyyarivu:,ashok:,jeeva:,gokul:

# Public URL (used in links)
HUB_PUBLIC_URL=http://localhost:4100

# Optional DrugDB API key (drugdb.in/account) for the Learn "Indian medicine data" live search.
# Without it, DrugDB's visitor limits apply (400 searches a day).
DRUGDB_API_KEY=

# Your hub first name or email. `npm run agent-task` acts as this user (docs/team/AGENT_TASK_WORKFLOW.md).
HUB_AGENT_AS=

# Outgoing email (assignments, @mentions, review, password reset). Empty host = emails are only logged.
# Hostinger: host smtp.hostinger.com, port 465 (implicit TLS). Port 587 = STARTTLS: set HUB_SMTP_SECURE=false.
HUB_SMTP_HOST=
HUB_SMTP_PORT=465
HUB_SMTP_SECURE=
HUB_SMTP_USER=
HUB_SMTP_PASSWORD=
# Sender shown to people; most providers require it to match HUB_SMTP_USER. Defaults to HUB_SMTP_USER.
HUB_SMTP_FROM=
