# Copy to .env.local (never committed). Public values only: this is a static SPA, it holds no secrets.

# API mocking with MSW (src/lib/mocks) — LOCAL DEV ONLY. Ignored by `next build`, so staging and production
# always use the real meno-api and its database.
#   all      – the whole API is mocked in the browser (no backend needed; data lives in sessionStorage)
#   missing  – only endpoints meno-api doesn't serve yet are mocked (contracts/openapi/proposed/auth.yaml)
#   off      – everything goes to meno-api
NEXT_PUBLIC_API_MOCKING=all

# Dev server only: where /api is proxied when mocking is "missing" or "off". Same-origin proxy, so the
# HttpOnly refresh cookie works. Local backend: http://localhost:8080 · shared staging (real staging DB, so only
# create test accounts there): https://meno-api-staging.azurewebsites.net (Swagger: /swagger-ui/index.html)
MENO_API_ORIGIN=http://localhost:8080
