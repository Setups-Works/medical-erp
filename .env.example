# =====================================================================
# MENO — Local development (docker compose)
# Copy to .env and fill in values. NEVER commit the real file.
# Secrets marked [SECRET] come from your own machine (use the dummy values below).
# =====================================================================

# ---------- General ----------
MENO_ENV=development
SPRING_PROFILES_ACTIVE=development
TZ=Asia/Kolkata
MENO_PUBLIC_WEB_URL=http://localhost:3000
MENO_PUBLIC_API_URL=http://localhost:8080

# ---------- PostgreSQL ----------
MENO_DB_URL=jdbc:postgresql://postgres:5432/meno?sslmode=disable
MENO_DB_USER=meno_app
MENO_DB_PASSWORD=change-me                         # [SECRET] runtime role (no DDL rights)
MENO_FLYWAY_USER=meno_owner
MENO_FLYWAY_PASSWORD=change-me                     # [SECRET] migration role
MENO_DB_POOL_SIZE=10

# ---------- Redis ----------
MENO_REDIS_URL=redis://redis:6379/0

# ---------- Object storage ----------
MENO_STORAGE_PROVIDER=s3
MENO_STORAGE_ENDPOINT=http://minio:9000
MENO_STORAGE_BUCKET=meno-dev
MENO_STORAGE_ACCESS_KEY=meno
MENO_STORAGE_SECRET_KEY=meno-dev-secret            # dev only

# ---------- Auth / JWT ----------
MENO_JWT_ISSUER=http://localhost:8080
MENO_JWT_KID=meno-development-1
MENO_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem   # [SECRET] ES256 key file, never inline
MENO_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem     # ES256 public key (not secret)
# Hosts without secret files (Azure App Service, ADR-0018): leave the *_PATH lines out and set the PEM text instead.
# MENO_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"   # [SECRET]
# MENO_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----"
MENO_LOGIN_MAX_FAILED_ATTEMPTS=10
MENO_LOGIN_LOCK_DURATION=PT15M
MENO_MIN_PASSWORD_LENGTH=10                             # SECURITY.md minimum
MENO_SIGNUP_ENABLED=true                                # public sign-up (POST /api/v1/auth/signup)
MENO_SIGNUP_START_OPTIONS=TRIAL,DEMO,LICENSE_KEY
MENO_SIGNUP_TERMS_VERSION=draft-2026-11                 # version of the terms + privacy notice shown (Hub #868)
MENO_RATE_LIMIT_ENABLED=true                            # per-IP limits in the API (no nginx on App Service)
MENO_RATE_LIMIT_LOGIN=10                                # per minute
MENO_RATE_LIMIT_SIGNUP=5                                # per 10 minutes
MENO_FY_START_MONTH=4                                   # financial year starts 1 April
MENO_GO_LIVE_MAX_DAYS_AHEAD=7
MENO_GSTIN_PROVIDER=none                                       # none | gstverify (provider not decided, R-31 ⚠)
MENO_GSTIN_API_KEY=                                     # [SECRET] only if the chosen plan needs one
MENO_GSTIN_CACHE_TTL=PT24H
MENO_GSTIN_LOOKUPS_PER_MINUTE=30
MENO_JWT_ACCESS_TTL=PT15M
MENO_JWT_REFRESH_TTL=P30D
MENO_COOKIE_SECURE=false
MENO_COOKIE_DOMAIN=localhost
MENO_API_DOCS_ENABLED=true                              # Swagger UI /swagger-ui.html + spec /v3/api-docs

# ---------- Mail ----------
MENO_MAIL_HOST=mailpit
MENO_MAIL_PORT=1025
MENO_MAIL_FROM="MENO Dev <no-reply@meno.local>"
MENO_MAIL_AUTH=false                                    # Mailpit needs no login
MENO_MAIL_STARTTLS=false
MENO_EMAIL_VERIFICATION_TTL=PT24H                       # verification link lifetime (ONBOARDING.md step 2)
MENO_VERIFICATION_RESEND_COOLDOWN=PT60S
MENO_PASSWORD_RESET_TTL=PT30M                           # reset link lifetime (AUT-01)
MENO_PASSWORD_RESET_COOLDOWN=PT60S

# ---------- Observability ----------
MENO_LOG_LEVEL=DEBUG
MENO_LOG_FORMAT=text
MENO_SENTRY_DSN=                                   # optional in development
MENO_SENTRY_ENVIRONMENT=development
MENO_SENTRY_TRACES_SAMPLE_RATE=0

# ---------- Integrations (P5+) ----------
MENO_GSP_MODE=sandbox
MENO_GSP_BASE_URL=
MENO_GSP_CLIENT_ID=
MENO_GSP_CLIENT_SECRET=                            # [SECRET]
MENO_WHATSAPP_PROVIDER=none                        # none | <provider>
MENO_WHATSAPP_API_KEY=                             # [SECRET]
MENO_SMS_PROVIDER=none
MENO_SMS_API_KEY=                                  # [SECRET]
MENO_SMS_DLT_ENTITY_ID=

# ---------- Feature flags ----------
MENO_FEATURES_OFFLINE_SYNC=true
MENO_FEATURES_EINVOICE=false
MENO_FEATURES_WHOLESALE=true

# ---------- Web (build-time, NOT secret) ----------
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Local containers ----------
POSTGRES_PASSWORD=postgres-dev
MINIO_ROOT_USER=meno
MINIO_ROOT_PASSWORD=meno-dev-secret

# AI assistant (P7, docs/architecture/AI_ASSISTANT.md). Off unless a key is set; CI uses a mock, never the real provider.
MENO_AI_PROVIDER=groq
MENO_AI_GROQ_API_KEY=                              # [SECRET] Key Vault only
MENO_AI_MODEL=                                     # chosen in ADR-0017
MENO_AI_TIMEOUT_SECONDS=30
MENO_AI_MAX_TOKENS=800
MENO_AI_MAX_TOOL_ROUNDS=3
MENO_AI_RETRIES=1
