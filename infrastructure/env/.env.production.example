# =====================================================================
# MENO — PRODUCTION (Azure VM vm-meno-prod)
# Now (ADR-0018): set these as App settings on the production App Service (docs/deployment/AZURE_APP_SERVICE.md).
# Later on a VM: copy to /opt/meno/.env on the production VM (chmod 600, owner root) and fill in values. NEVER commit the real file.
# Secrets marked [SECRET] come from GitHub Environment 'production' — only Nitheesh and Jeeva can read it.
# =====================================================================

# ---------- General ----------
MENO_ENV=production
SPRING_PROFILES_ACTIVE=production
TZ=Asia/Kolkata
MENO_PUBLIC_WEB_URL=https://app.example.com
MENO_PUBLIC_API_URL=https://app.example.com

# ---------- PostgreSQL ----------
MENO_DB_URL=jdbc:postgresql://psql-meno.postgres.database.azure.com:5432/meno_prod?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory   # own server psql-meno-prod after the pilot
MENO_DB_USER=meno_app
MENO_DB_PASSWORD=change-me                         # [SECRET] runtime role (no DDL rights)
MENO_FLYWAY_USER=meno_owner
MENO_FLYWAY_PASSWORD=change-me                     # [SECRET] migration role
MENO_DB_POOL_SIZE=20

# ---------- Redis ----------
MENO_REDIS_URL=redis://redis:6379/0

# ---------- Object storage ----------
MENO_STORAGE_PROVIDER=azure-blob
MENO_STORAGE_ACCOUNT=stmenoprod
MENO_STORAGE_CONTAINER=files
MENO_STORAGE_CONNECTION_STRING=                 # [SECRET]
MENO_BACKUP_CONTAINER=backups

# ---------- Auth / JWT ----------
MENO_JWT_ISSUER=https://app.example.com
MENO_JWT_KID=meno-production-1
MENO_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem   # [SECRET] ES256 key file, never inline
MENO_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem     # ES256 public key (not secret)
# Hosts without secret files (Azure App Service, ADR-0018): leave the *_PATH lines out and set the PEM text instead.
# MENO_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"   # [SECRET]
# MENO_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----"
MENO_LOGIN_MAX_FAILED_ATTEMPTS=10
MENO_LOGIN_LOCK_DURATION=PT15M
MENO_MIN_PASSWORD_LENGTH=10                             # SECURITY.md minimum
MENO_SIGNUP_ENABLED=false                               # public sign-up; production stays closed until OTP + rate limits (AUT-04)
MENO_SIGNUP_START_OPTIONS=TRIAL,DEMO,LICENSE_KEY
MENO_SIGNUP_TERMS_VERSION=draft-2026-11                 # version of the terms + privacy notice shown (Hub #868)
MENO_JWT_ACCESS_TTL=PT15M
MENO_JWT_REFRESH_TTL=P30D
MENO_COOKIE_SECURE=true
MENO_COOKIE_DOMAIN=app.example.com
MENO_API_DOCS_ENABLED=false                             # Swagger UI /swagger-ui.html + spec /v3/api-docs (never in production)

# ---------- Mail ----------
MENO_MAIL_HOST=smtp.example.com
MENO_MAIL_PORT=587
MENO_MAIL_USER=
MENO_MAIL_PASSWORD=                               # [SECRET]
MENO_MAIL_FROM="MENO <no-reply@example.com>"

# ---------- Observability ----------
MENO_LOG_LEVEL=INFO
MENO_LOG_FORMAT=json
MENO_SENTRY_DSN=                                   # optional in development
MENO_SENTRY_ENVIRONMENT=production
MENO_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- Integrations (P5+) ----------
MENO_GSP_MODE=live
MENO_GSP_BASE_URL=
MENO_GSP_CLIENT_ID=
MENO_GSP_CLIENT_SECRET=                            # [SECRET]
MENO_WHATSAPP_PROVIDER=none                        # none | <provider>
MENO_WHATSAPP_API_KEY=                             # [SECRET]
MENO_SMS_PROVIDER=none
MENO_SMS_API_KEY=                                  # [SECRET]
MENO_SMS_DLT_ENTITY_ID=

# ---------- Feature flags ----------
MENO_FEATURES_OFFLINE_SYNC=false
MENO_FEATURES_EINVOICE=false
MENO_FEATURES_WHOLESALE=true

# ---------- Web (build-time, NOT secret) ----------
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Production-only ----------
MENO_RATE_LIMIT_AUTH_PER_MIN=10
MENO_RATE_LIMIT_API_PER_MIN=300
MENO_BACKUP_RETENTION=7d,4w,12m
MENO_ALERT_EMAIL=ops@example.com

# AI assistant (P7, docs/architecture/AI_ASSISTANT.md). Off unless a key is set; CI uses a mock, never the real provider.
MENO_AI_PROVIDER=groq
MENO_AI_GROQ_API_KEY=                              # [SECRET] Key Vault only
MENO_AI_MODEL=                                     # chosen in ADR-0017
MENO_AI_TIMEOUT_SECONDS=30
MENO_AI_MAX_TOKENS=800
MENO_AI_MAX_TOOL_ROUNDS=3
MENO_AI_RETRIES=1
