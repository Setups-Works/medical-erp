# =====================================================================
# MENO — Shared development server (optional)
# Copy to /opt/meno/.env on the dev VM and fill in values. NEVER commit the real file.
# Secrets marked [SECRET] come from GitHub Environment 'development'.
# =====================================================================

# ---------- General ----------
MENO_ENV=development
SPRING_PROFILES_ACTIVE=development
TZ=Asia/Kolkata
MENO_PUBLIC_WEB_URL=https://dev.example.com
MENO_PUBLIC_API_URL=https://dev-api.example.com

# ---------- PostgreSQL ----------
MENO_DB_URL=jdbc:postgresql://psql-meno.postgres.database.azure.com:5432/meno?sslmode=require
MENO_DB_USER=meno_app
MENO_DB_PASSWORD=change-me                         # [SECRET] runtime role (no DDL rights)
MENO_FLYWAY_USER=meno_owner
MENO_FLYWAY_PASSWORD=change-me                     # [SECRET] migration role
MENO_DB_POOL_SIZE=10

# ---------- Redis ----------
MENO_REDIS_URL=redis://redis:6379/0

# ---------- Object storage ----------
MENO_STORAGE_PROVIDER=azure-blob
MENO_STORAGE_ACCOUNT=stmenodev
MENO_STORAGE_CONTAINER=files
MENO_STORAGE_CONNECTION_STRING=                 # [SECRET]

# ---------- Auth / JWT ----------
MENO_JWT_ISSUER=https://dev-api.example.com
MENO_JWT_KID=meno-development-1
MENO_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem   # [SECRET] ES256 key file, never inline
MENO_JWT_ACCESS_TTL=PT15M
MENO_JWT_REFRESH_TTL=P30D
MENO_COOKIE_SECURE=false
MENO_COOKIE_DOMAIN=localhost

# ---------- Mail ----------
MENO_MAIL_HOST=smtp.example.com
MENO_MAIL_PORT=587
MENO_MAIL_USER=
MENO_MAIL_PASSWORD=                               # [SECRET]
MENO_MAIL_FROM="MENO Dev <no-reply@example.com>"

# ---------- Observability ----------
MENO_LOG_LEVEL=DEBUG
MENO_LOG_FORMAT=text
MENO_SENTRY_DSN=                                   # optional in development
MENO_SENTRY_ENVIRONMENT=development
MENO_SENTRY_TRACES_SAMPLE_RATE=0

# ---------- Integrations (P5+) ----------
MENO_GSP_MODE=sandbox
MENO_GSP_BASE_URL=
MENO_GSP_CLIENT_ID=
MENO_GSP_CLIENT_SECRET=                            # [SECRET]
MENO_WHATSAPP_PROVIDER=none                        # none | <provider>
MENO_WHATSAPP_API_KEY=                             # [SECRET]
MENO_SMS_PROVIDER=none
MENO_SMS_API_KEY=                                  # [SECRET]
MENO_SMS_DLT_ENTITY_ID=

# ---------- Feature flags ----------
MENO_FEATURES_OFFLINE_SYNC=true
MENO_FEATURES_EINVOICE=false
MENO_FEATURES_WHOLESALE=true

# ---------- Web (build-time, NOT secret) ----------
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=

# AI assistant (P7, docs/architecture/AI_ASSISTANT.md). Off unless a key is set; CI uses a mock, never the real provider.
MENO_AI_PROVIDER=groq
MENO_AI_GROQ_API_KEY=                              # [SECRET] Key Vault only
MENO_AI_MODEL=                                     # chosen in ADR-0017
MENO_AI_TIMEOUT_SECONDS=30
MENO_AI_MAX_TOKENS=800
MENO_AI_MAX_TOOL_ROUNDS=3
MENO_AI_RETRIES=1
